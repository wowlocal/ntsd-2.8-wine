@@ -348,6 +390,19 @@
     thunk->unix_thunk.addr  = PtrToUlong( unix_call_32to64 );
     thunk->unix_thunk.cs    = cs64_sel;
 
+    {
+        char brand[64];
+        if (!NtQuerySystemInformation(SystemProcessorBrandString, brand, sizeof(brand), NULL))
+            ntsd_is_rosetta = strstr(brand, "VirtualApple") != NULL;
+        if (ntsd_is_rosetta)
+        {
+            struct rosetta_gates *gates = (void *)code_buffer;
+            init_rosetta_gate(&gates->syscall_gate, syscall_32to64, cs64_sel);
+            init_rosetta_gate(&gates->unix_gate, unix_call_32to64, cs64_sel);
+            size = sizeof(*gates);
+            TRACE("NTSD Rosetta far-call/return gates enabled\n");
+        }
+    }
     NtProtectVirtualMemory( GetCurrentProcess(), (void **)&thunk, &size, PAGE_EXECUTE_READ, &old_prot );
     return STATUS_SUCCESS;
 }
