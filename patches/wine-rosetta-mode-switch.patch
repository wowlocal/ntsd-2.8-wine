--- a/dlls/wow64cpu/cpu.c
+++ b/dlls/wow64cpu/cpu.c
@@ -52,6 +52,32 @@
 UINT cs32_sel = 0;
 UINT ss32_sel = 0;
 
+/* Rosetta requires far call/return to change decoding mode. The far-call
+ * trampoline follows the LGPL implementation documented by swingby-wine. */
+#pragma pack(push,1)
+struct rosetta_gate {
+    BYTE opcode, modrm;
+    DWORD operand, address;
+    WORD selector;
+    BYTE discard_frame[3], jump[6];
+    ULONG64 target;
+};
+struct rosetta_gates { struct rosetta_gate syscall_gate, unix_gate; };
+#pragma pack(pop)
+int ntsd_is_rosetta;
+static void init_rosetta_gate(struct rosetta_gate *gate, void *target, USHORT selector)
+{
+    static const BYTE discard[] = {0x83,0xc4,0x08};
+    static const BYTE jump[] = {0xff,0x25,0,0,0,0};
+    gate->opcode = 0xff;
+    gate->modrm = 0x1d; /* lcall m16:32 */
+    gate->operand = PtrToUlong(&gate->address);
+    gate->address = PtrToUlong(gate->discard_frame);
+    gate->selector = selector;
+    memcpy(gate->discard_frame, discard, sizeof(discard));
+    memcpy(gate->jump, jump, sizeof(jump));
+    gate->target = (ULONG_PTR)target;
+}
 static USHORT cs64_sel;
 static USHORT ds64_sel;
 static USHORT fs32_sel;
@@ -211,7 +237,15 @@
                    "movl %edx,4(%rsp)\n\t"
                    "movl 0xc4(%r13),%r14d\n\t"  /* context->Esp */
                    "xchgq %r14,%rsp\n\t"
+                   "cmpl $0,ntsd_is_rosetta(%rip)\n\t"
+                   "jne 1f\n\t"
                    "ljmp *(%r14)\n"
+                   "1: subq $16,%rsp\n\t"
+                   "movl 4(%r14),%edx\n\t"
+                   "movq %rdx,8(%rsp)\n\t"
+                   "movl (%r14),%edx\n\t"
+                   "movq %rdx,(%rsp)\n\t"
+                   "lretq\n"
                    ".Lsyscall_32to64_return:\n\t"
                    "movq %rsp,%r14\n\t"
                    "movl 0xa8(%r13),%edx\n\t"   /* context->Edx */
@@ -271,7 +305,15 @@
                    "movl %edx,4(%rsp)\n\t"
                    "movl 0xc4(%r13),%r14d\n\t"  /* context->Esp */
                    "xchgq %r14,%rsp\n\t"
-                   "ljmp *(%r14)" )
+                   "cmpl $0,ntsd_is_rosetta(%rip)\n\t"
+                   "jne 1f\n\t"
+                   "ljmp *(%r14)\n"
+                   "1: subq $16,%rsp\n\t"
+                   "movl 4(%r14),%edx\n\t"
+                   "movq %rdx,8(%rsp)\n\t"
+                   "movl (%r14),%edx\n\t"
+                   "movq %rdx,(%rsp)\n\t"
+                   "lretq" )
 
 
