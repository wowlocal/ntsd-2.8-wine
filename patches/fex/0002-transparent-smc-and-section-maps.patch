+uint32_t QueryId=~0U, ProtectId=~0U, MapId=~0U, MapExId=~0U;
+uint32_t ServiceId(uint64_t GuestNt, const char* Name) {
+  auto* Base=reinterpret_cast<uint8_t*>(GuestNt);
+  auto* Dos=reinterpret_cast<IMAGE_DOS_HEADER*>(Base);
+  auto* Nt=reinterpret_cast<IMAGE_NT_HEADERS32*>(Base+Dos->e_lfanew);
+  auto* Ex=reinterpret_cast<IMAGE_EXPORT_DIRECTORY*>(Base+Nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT].VirtualAddress);
+  auto* Names=reinterpret_cast<uint32_t*>(Base+Ex->AddressOfNames);
+  auto* Ordinals=reinterpret_cast<uint16_t*>(Base+Ex->AddressOfNameOrdinals);
+  auto* Functions=reinterpret_cast<uint32_t*>(Base+Ex->AddressOfFunctions);
+  for(uint32_t i=0;i<Ex->NumberOfNames;i++) {
+    if(strcmp(reinterpret_cast<char*>(Base+Names[i]),Name)) continue;
+    const auto* Code=Base+Functions[Ordinals[i]];
+    for(unsigned j=0;j<12;j++) if(Code[j]==0xb8) { uint32_t Id; memcpy(&Id,Code+j+1,4); return Id; }
+  }
+  return ~0U;
+}
+void Init(HMODULE NativeNt, uint64_t GuestNt) {
+  ReadMemory=reinterpret_cast<ReadFn>(GetProcAddress(NativeNt,"NtReadVirtualMemory"));
+  QueryId=ServiceId(GuestNt,"NtQueryVirtualMemory");
+  ProtectId=ServiceId(GuestNt,"NtProtectVirtualMemory");
+  MapId=ServiceId(GuestNt,"NtMapViewOfSection");
+  MapExId=ServiceId(GuestNt,"NtMapViewOfSectionEx");
+}
+bool Read(uint32_t Address, void* Buffer, SIZE_T Size) {
+  SIZE_T Bytes=0;
+  return ReadMemory && !ReadMemory(NtCurrentProcess(),ULongToPtr(Address),Buffer,Size,&Bytes) && Bytes==Size;
+}
+bool CurrentProcess(uint32_t Handle) {
+  if (Handle==0xffffffffU) return true;
+  PROCESS_BASIC_INFORMATION Info;
+  return !NtQueryInformationProcess(ULongToHandle(Handle),ProcessBasicInformation,&Info,sizeof Info,nullptr) &&
+         Info.UniqueProcessId==reinterpret_cast<ULONG_PTR>(reinterpret_cast<__TEB*>(NtCurrentTeb())->ClientId.UniqueProcess);
+}
+struct Call {
+  uint32_t Args[10] {};
+  std::optional<ULONG> PreviousProtection;
+  bool Self=false;
+};
+Call Before(uint32_t Id, uint32_t ArgumentAddress) {
+  Call C;
+  const bool Mapping=Id==MapId || Id==MapExId;
+  if((Id!=QueryId && Id!=ProtectId && !Mapping) || !Read(ArgumentAddress,C.Args,Mapping ? sizeof C.Args : 20)) return C;
+  C.Self=CurrentProcess(C.Args[Mapping ? 1 : 0]);
+  if(C.Self && Id==ProtectId) {
+    uint32_t Base;
+    if(Read(C.Args[1],&Base,sizeof Base)) C.PreviousProtection=InvalidationTracker->GuestProtection(Base);
+  }
+  return C;
+}
+void After(uint32_t Id, uint32_t Status, const Call& C) {
+  if(Status || !C.Self) return;
+  if(Id==MapId || Id==MapExId) {
+    uint32_t Base=0,Size=0;
+    if(!Read(C.Args[2],&Base,sizeof Base) || !Read(C.Args[Id==MapId ? 6 : 4],&Size,sizeof Size)) return;
+    std::scoped_lock Lock(ThreadCreationMutex);
+    const uint64_t End=uint64_t(Base)+Size;
+    for(uint64_t Address=Base;Address<End;) {
+      MEMORY_BASIC_INFORMATION Info;
+      if(NtQueryVirtualMemory(NtCurrentProcess(),reinterpret_cast<void*>(Address),MemoryBasicInformation,&Info,sizeof Info,nullptr)) break;
+      const uint64_t Next=std::min<uint64_t>(End,reinterpret_cast<uintptr_t>(Info.BaseAddress)+Info.RegionSize);
+      if(Next<=Address) break;
+      if(Info.Type!=MEM_IMAGE && Info.State==MEM_COMMIT) {
+        InvalidationTracker->HandleMemoryProtectionNotification(Address,Next-Address,Info.Protect);
+      }
+      Address=Next;
+    }
+  } else if(Id==ProtectId && C.PreviousProtection) {
+    memcpy(ULongToPtr(C.Args[4]),&*C.PreviousProtection,sizeof(ULONG));
+  } else if(Id==QueryId && C.Args[2]==MemoryBasicInformation && C.Args[4]>=28) {
+    MEMORY_BASIC_INFORMATION Info;
+    if(!InvalidationTracker->QueryGuestBasicInformation(C.Args[1],Info) && Info.State==MEM_COMMIT) {
+      struct Basic32 { uint32_t Base, AllocationBase, AllocationProtect, RegionSize, State, Protect, Type; };
+      const Basic32 Guest {
+        static_cast<uint32_t>(reinterpret_cast<uintptr_t>(Info.BaseAddress)),
+        static_cast<uint32_t>(reinterpret_cast<uintptr_t>(Info.AllocationBase)),Info.AllocationProtect,
+        static_cast<uint32_t>(std::min<uint64_t>(Info.RegionSize,
+          (1ULL << 32)-reinterpret_cast<uintptr_t>(Info.BaseAddress))),Info.State,Info.Protect,Info.Type};
+      memcpy(ULongToPtr(C.Args[3]),&Guest,sizeof Guest);
+    }
+  }
+}
