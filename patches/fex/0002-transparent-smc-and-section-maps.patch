+void InvalidationTracker::ForgetTraps(uint64_t Begin, uint64_t End) {
+  auto It = TrappedProtections.lower_bound(Begin);
+  while (It != TrappedProtections.end() && It->first < End) {
+    It = TrappedProtections.erase(It);
+  }
+}
+
+void InvalidationTracker::RestoreTraps() {
+  for (auto It = TrappedProtections.begin(); It != TrappedProtections.end();) {
+    void* Address = reinterpret_cast<void*>(It->first);
+    SIZE_T Size = FEXCore::Utils::FEX_PAGE_SIZE;
+    ULONG Previous;
+    if (!NtProtectVirtualMemory(NtCurrentProcess(), &Address, &Size, It->second, &Previous)) {
+      It = TrappedProtections.erase(It);
+    } else {
+      ++It;
+    }
+  }
+}
