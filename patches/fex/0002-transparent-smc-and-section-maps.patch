+NTSTATUS InvalidationTracker::QueryGuestBasicInformation(uint64_t Address, MEMORY_BASIC_INFORMATION& Info) {
+  std::shared_lock Lock(IntervalsLock);
+  // A physical region can contain both a real read-only page and a trapped
+  // writable page. First split at trap boundaries, then merge regions using
+  // their requested protections rather than their temporary host protections.
+  auto Segment = [&](uint64_t At, MEMORY_BASIC_INFORMATION& Out) -> NTSTATUS {
+    const auto Status = NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(At), MemoryBasicInformation,
+                                            &Out, sizeof Out, nullptr);
+    if (Status) return Status;
+    uint64_t Begin = reinterpret_cast<uint64_t>(Out.BaseAddress);
+    uint64_t End = Begin + Out.RegionSize;
+    const auto Page = At & FEXCore::Utils::FEX_PAGE_MASK;
+    auto It = TrappedProtections.find(Page);
+    if (It != TrappedProtections.end()) {
+      Out.Protect = It->second;
+      Begin = Page;
+      End = Page + FEXCore::Utils::FEX_PAGE_SIZE;
+      while (++It != TrappedProtections.end() && It->first == End && It->second == Out.Protect) {
+        End += FEXCore::Utils::FEX_PAGE_SIZE;
+      }
+      Begin = std::max(Begin, reinterpret_cast<uint64_t>(Out.BaseAddress));
+      End = std::min(End, reinterpret_cast<uint64_t>(Out.BaseAddress) + Out.RegionSize);
+    } else {
+      auto Next = TrappedProtections.lower_bound(Page);
+      if (Next != TrappedProtections.end()) End = std::min(End, Next->first);
+      if (Next != TrappedProtections.begin()) Begin = std::max(Begin, std::prev(Next)->first + FEXCore::Utils::FEX_PAGE_SIZE);
+    }
+    Out.BaseAddress = reinterpret_cast<void*>(Begin);
+    Out.RegionSize = End - Begin;
+    return Status;
+  };
+  auto Same = [](const MEMORY_BASIC_INFORMATION& A, const MEMORY_BASIC_INFORMATION& B) {
+    return A.AllocationBase == B.AllocationBase && A.AllocationProtect == B.AllocationProtect &&
+           A.State == B.State && A.Protect == B.Protect && A.Type == B.Type;
+  };
+  auto Status = Segment(Address, Info);
+  if (Status || Info.State != MEM_COMMIT) return Status;
+  uint64_t Begin = reinterpret_cast<uint64_t>(Info.BaseAddress);
+  uint64_t End = Begin + Info.RegionSize;
+  MEMORY_BASIC_INFORMATION Neighbor;
+  while (End < (1ULL << 32) && !Segment(End, Neighbor) && Same(Info, Neighbor) &&
+         reinterpret_cast<uint64_t>(Neighbor.BaseAddress) == End && Neighbor.RegionSize) {
+    End += Neighbor.RegionSize;
+  }
+  Info.BaseAddress = reinterpret_cast<void*>(Begin);
+  Info.RegionSize = End - Begin;
+  return Status;
+}
