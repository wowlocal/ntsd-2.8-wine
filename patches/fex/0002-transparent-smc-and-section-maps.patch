+std::optional<ULONG> InvalidationTracker::GuestProtection(uint64_t Address) {
+  std::shared_lock Lock(IntervalsLock);
+  const auto It = TrappedProtections.find(Address & FEXCore::Utils::FEX_PAGE_MASK);
+  return It == TrappedProtections.end() ? std::nullopt : std::optional<ULONG>(It->second);
+}
